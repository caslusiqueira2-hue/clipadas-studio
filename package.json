{
  "name": "clipadas-studio",
  "version": "1.0.0",
  "description": "Clipadas Studio - Plataforma de Cortes Virais & Legendas Dinâmicas com IA",
  "main": "server/server.js",
  "scripts": {
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "tunnel": "node server/tunnel.js",
    "mobile": "node server/tunnel.js",
    "start": "node server/server.js",
    "postinstall": "npm --prefix client install && npm --prefix client run build"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^1.4.5-lts.1",
    "qrcode-terminal": "^0.12.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
